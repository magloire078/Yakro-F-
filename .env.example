# Copy this file to .env.local and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Firebase (web client)
NEXT_PUBLIC_FIREBASE_API_KEY=

# Cloudinary (image hosting)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# Server-only: required for image deletion via the cloudinary-actions server action.
CLOUDINARY_API_SECRET=

# Google Maps (geocoding / map tiles)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Genkit / Gemini (AI flows)
GEMINI_API_KEY=

# Local-only: path to a Firebase service-account JSON used by the Admin SDK
# during dev/test. Not needed on Firebase App Hosting (ADC is provided).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
