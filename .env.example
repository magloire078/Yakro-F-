# Copy this file to .env.local and fill in the values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.

# Firebase (web client)
NEXT_PUBLIC_FIREBASE_API_KEY=

# Cloudinary (image hosting)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
# Server-only: required for image deletion via the cloudinary-actions server action.
CLOUDINARY_API_SECRET=

# Google Maps (geocoding / map tiles)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Genkit / Gemini (AI flows)
GEMINI_API_KEY=

# Required on Vercel: Application Default Credentials don't exist there, so
# the Admin SDK (notifications, stock actions, payments) needs an explicit
# service-account key. Paste the FULL JSON content as one line.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# CinetPay (Mobile Money: Orange Money, MTN Money, Moov Money). Leave unset
# to keep Mobile Money hidden and only offer "Espèces à la livraison" — see
# docs/deployment/mobile-money-setup.md before setting these in production.
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=

# Base URL used to build CinetPay return/notify URLs. On Vercel this can be
# left unset (VERCEL_URL is used automatically); set it explicitly once a
# custom domain is live.
# NEXT_PUBLIC_APP_URL=https://yakrofe.com

# Set to "true" only once CINETPAY_API_KEY/CINETPAY_SITE_ID are configured
# and the webhook URL is registered with CinetPay — see the setup doc.
NEXT_PUBLIC_PAYMENTS_MOBILE_MONEY_ENABLED=false
