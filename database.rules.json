
{
  "rules": {
    "service cloud.firestore": {
      "match": "/databases/{database}/documents": {
        "function isUserAuthenticated()": "return request.auth != null;",
        "function isUser(uid)": "return isUserAuthenticated() && request.auth.uid == uid;",
        "function isSuperAdmin()": "return isUserAuthenticated() && get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data.get('roleSysteme', 'User') == 'SuperAdmin';",
        "function isRestaurantOwner(restaurantId)": "return isUser(get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.proprietaireId);",
        
        "match": "/restaurants/{restaurantId}": {
          "allow": "read, write: if false;"
        },
        "match": "/plats/{platId}": {
          "allow": "read, write: if false;"
        },
        "match": "/commandes/{orderId}": {
          "allow": "read, write: if false;"
        },
        
        "match": "/utilisateurs": {
          "allow": "list: if isSuperAdmin();"
        },
        "match": "/utilisateurs/{userId}": {
          "allow": "read: if isUser(userId) || isSuperAdmin();",
          "allow": "update: if isUser(userId) || isSuperAdmin();",
          "allow": "create: if isUserAuthenticated();"
        }
      }
    }
  }
}
