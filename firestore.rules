
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getRestaurantDoc(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId));
    }
    
    function isRestaurantOwner(restaurantId) {
      return isSignedIn() && getRestaurantDoc(restaurantId).data.ownerId == request.auth.uid;
    }

    // --- Collections Rules ---
    
    // USERS: Can only read/write their own profile
    match /utilisateurs/{userId} {
      allow read, update, delete: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn();
    }
    
    // RESTAURANTS: Anyone signed in can read. Only owner can write.
    match /restaurants/{restaurantId} {
      allow read: if isSignedIn();
      allow write: if isRestaurantOwner(restaurantId);
    }
    
    // MENU ITEMS (PLATS): Anyone signed in can read. Only associated restaurant owner can write.
    match /plats/{platId} {
      allow read: if isSignedIn();
      allow create: if isRestaurantOwner(request.resource.data.restaurantId);
      allow update, delete: if isRestaurantOwner(get(/databases/$(database)/documents/plats/$(platId)).data.restaurantId);
    }
    
    // ORDERS (COMMANDES)
    match /commandes/{commandeId} {
      // READ: Users can read their own orders.
      // Restaurateurs can read their restaurant's orders.
      // Deliverers can read available orders or orders assigned to them.
      allow read: if isSignedIn() && (
        isOwner(resource.data.userId) ||
        isRestaurantOwner(resource.data.restaurantId) ||
        resource.data.status == 'En Préparation' ||
        isOwner(resource.data.delivererId)
      );
      
      // CREATE: Only the user placing the order can create it.
      allow create: if isSignedIn() && isOwner(request.resource.data.userId);
      
      // UPDATE: A command can be updated by:
      // 1. The restaurateur who owns the restaurant associated with the order.
      // 2. A deliverer who is assigning themselves to the order ('En Préparation' -> 'En Route').
      // 3. The deliverer who is already assigned to the order.
      allow update: if isSignedIn() && (
        isRestaurantOwner(resource.data.restaurantId) ||
        (resource.data.status == 'En Préparation' && request.resource.data.status == 'En Route' && isOwner(request.resource.data.delivererId)) ||
        isOwner(resource.data.delivererId)
      );
    }
  }
}
