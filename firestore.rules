
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check role
    function isRole(role) {
      return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data.role == role;
    }

    // Helper function to check restaurant ownership
    function isRestaurantOwner(restaurantId) {
      return get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    // Collection: utilisateurs
    match /utilisateurs/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow create: if request.auth.uid != null;
    }

    // Collection: restaurants
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isRole('restaurateur') && request.auth.uid == request.resource.data.ownerId;
      allow update: if isRole('restaurateur') && isRestaurantOwner(restaurantId);
    }
    
    // Collection: plats
    match /plats/{platId} {
        allow read: if true;
        allow create: if isRole('restaurateur') && isRestaurantOwner(request.resource.data.restaurantId);
        allow update: if isRole('restaurateur') && isRestaurantOwner(resource.data.restaurantId);
        allow delete: if isRole('restaurateur') && isRestaurantOwner(resource.data.restaurantId);
    }

    // Collection: commandes
    match /commandes/{commandeId} {
      allow read: if 
          // Client can read their own orders
          (request.auth.uid == resource.data.userId) ||
          // Deliverer can read orders assigned to them
          (resource.data.delivererId != null && request.auth.uid == resource.data.delivererId) ||
          // Restaurateur can read orders for their restaurant
          (isRole('restaurateur') && isRestaurantOwner(resource.data.restaurantId));

      allow create: if isRole('client') && request.auth.uid == request.resource.data.userId;
      
      allow update: if 
          // Restaurateur can update status of their orders
          (isRole('restaurateur') && isRestaurantOwner(resource.data.restaurantId)) ||
          // Deliverer can accept an order or mark it as delivered
          (isRole('livreur') && (isRestaurantOwner(resource.data.restaurantId) == false) && (request.resource.data.delivererId == request.auth.uid || resource.data.delivererId == request.auth.uid));
    }
  }
}
