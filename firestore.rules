
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read access to restaurants and menu items
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if request.auth != null; // Only authenticated users can create/update
    }

    match /menuItems/{menuItemId} {
      allow read: if true;
      allow write: if request.auth != null; // Only authenticated users can create/update
    }

    // Orders can only be read/written by the user who owns them,
    // or by a logged-in deliverer.
    match /orders/{orderId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.delivererId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null; // Allow any authenticated user (e.g., deliverer) to update status
    }

    // Allow any other collection to be read/written by authenticated users.
    // This is a fallback and can be tightened later.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
