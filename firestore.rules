rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid));
    }

    function getRole() {
      return isAuth() ? getUserData().get('role', 'client') : 'client';
    }

    function getSystemRole() {
      return isAuth() && userExists() ? getUserData().get('roleSysteme', 'User') : 'User';
    }

    function isSuperAdmin() {
      return isAuth() && getSystemRole() == 'SuperAdmin';
    }

    function isRestaurateur() {
      return isAuth() && getRole() == 'restaurateur';
    }

    function isLivreur() {
      return isAuth() && getRole() == 'livreur';
    }

    function isRestaurantOwner(restaurantId) {
      return isAuth()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId))
        && isUser(get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.proprietaireId);
    }

    // Empêche un utilisateur d'auto-promouvoir son rôle ou son niveau système
    // en se mettant à jour lui-même. `pointsFidelite` et
    // `filleulRecompenseVersee` sont volontairement verrouillés : seul le
    // SDK Admin (processDeliveredOrderAction), qui contourne les rules,
    // peut les faire avancer. `parrainId` est fixé une seule fois à la
    // création du profil et ne peut plus changer ensuite. `premiumJusquau`
    // n'avance que via le webhook CinetPay Premium (Admin SDK).
    function userPrivilegesUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.get('roleSysteme', 'User')
             == resource.data.get('roleSysteme', 'User')
        && request.resource.data.get('pointsFidelite', 0) == resource.data.get('pointsFidelite', 0)
        && request.resource.data.get('parrainId', '') == resource.data.get('parrainId', '')
        && request.resource.data.get('filleulRecompenseVersee', false)
             == resource.data.get('filleulRecompenseVersee', false)
        && request.resource.data.get('premiumJusquau', null)
             == resource.data.get('premiumJusquau', null);
    }

    // Empêche la mutation des champs sensibles d'une commande lors d'une
    // transition d'état (le statut et livreurId sont gérés à part dans la
    // règle). `paiement` est volontairement inclus : seul l'Admin SDK
    // (webhook CinetPay, payment-actions), qui contourne les rules, peut
    // faire avancer un paiement — jamais un restaurateur/livreur/client via
    // une transition de statut classique. `codePromo` et `prioritaire` sont
    // verrouillés pour la même raison : fixés une fois à la création, ils
    // ne doivent plus pouvoir être ajoutés, changés ou retirés ensuite.
    function orderCoreUnchanged() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.restaurateurId == resource.data.restaurateurId
        && request.resource.data.total == resource.data.total
        && request.resource.data.sousTotal == resource.data.sousTotal
        && request.resource.data.fraisDeLivraison == resource.data.fraisDeLivraison
        && request.resource.data.tauxCommission == resource.data.tauxCommission
        && request.resource.data.montantCommission == resource.data.montantCommission
        && request.resource.data.revenuNet == resource.data.revenuNet
        && request.resource.data.plats == resource.data.plats
        && request.resource.data.date == resource.data.date
        && request.resource.data.paiement == resource.data.paiement
        && request.resource.data.get('livraisonTraitee', false)
             == resource.data.get('livraisonTraitee', false)
        && request.resource.data.get('prioritaire', false)
             == resource.data.get('prioritaire', false)
        && request.resource.data.get('codePromo', null)
             == resource.data.get('codePromo', null);
    }

    // ── Utilisateurs ─────────────────────────────────────────────────────
    match /utilisateurs/{userId} {
      allow get:  if isAuth() && (isUser(userId) || isSuperAdmin());
      allow list: if isSuperAdmin();

      // Création : seul l'utilisateur lui-même peut créer son profil, avec un
      // rôle valide et roleSysteme verrouillé à 'User' (l'élévation est
      // réservée aux SuperAdmin via update). `parrainId`, s'il est fourni
      // (lien/code de parrainage saisi à l'inscription), doit désigner un
      // utilisateur existant autre que soi-même ; `pointsFidelite` et
      // `filleulRecompenseVersee` ne peuvent jamais être pré-remplis par
      // le client à la création.
      allow create: if isAuth()
        && isUser(userId)
        && request.resource.data.role in ['client', 'restaurateur', 'livreur']
        && request.resource.data.get('roleSysteme', 'User') == 'User'
        && !('pointsFidelite' in request.resource.data)
        && !('filleulRecompenseVersee' in request.resource.data)
        && (
          !('parrainId' in request.resource.data) ||
          (
            request.resource.data.parrainId != userId &&
            exists(/databases/$(database)/documents/utilisateurs/$(request.resource.data.parrainId))
          )
        );

      // Update : l'utilisateur peut modifier son profil mais ni son rôle
      // applicatif ni son niveau système (ni les champs privilégiés
      // ci-dessus). SuperAdmin peut tout.
      allow update: if isAuth() && (
        (isUser(userId) && userPrivilegesUnchanged()) ||
        isSuperAdmin()
      );

      allow delete: if isSuperAdmin();
    }

    // ── Restaurants ───────────────────────────────────────────────────────
    match /restaurants/{restaurantId} {
      // Lecture publique, y compris sans authentification : la liste des
      // restaurants doit pouvoir se charger dès l'écran d'accueil (parcours
      // avant connexion), et exiger isAuth() ici exposait aussi les clients
      // déjà connectés à une vraie fenêtre de course : `onSnapshot` peut
      // démarrer dès que `user` devient non-nul côté client, avant que le
      // jeton d'ID Firebase ne soit réellement attaché aux requêtes
      // Firestore — la première tentative échouait alors en PERMISSION_DENIED,
      // une erreur non transitoire que le SDK ne retente jamais.
      allow read, list: if true;
      allow create: if isAuth()
        && isUser(request.resource.data.proprietaireId)
        && userExists()
        && (getRole() == 'restaurateur' || isSuperAdmin());
      allow update: if isRestaurantOwner(restaurantId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Plats ─────────────────────────────────────────────────────────────
    match /plats/{platId} {
      // Lecture publique pour la même raison que /restaurants ci-dessus.
      allow read, list: if true;
      allow create: if isAuth() && isRestaurantOwner(request.resource.data.restaurantId);
      allow update, delete: if isRestaurantOwner(resource.data.restaurantId) || isSuperAdmin();
    }

    // ── Commandes ─────────────────────────────────────────────────────────
    match /commandes/{orderId} {
      // Lecture : un utilisateur ne voit que les commandes qui le concernent.
      // Le moteur de règles applique cette contrainte aux `list` queries
      // également, ce qui force les clients à filtrer correctement leurs
      // requêtes. Un livreur peut voir toute commande éligible à une prise
      // en charge (Placée/En Préparation/Prête) — pas seulement celles déjà
      // assignées à lui — sinon il ne pourrait jamais découvrir de courses.
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.restaurateurId == request.auth.uid ||
        resource.data.livreurId == request.auth.uid ||
        isSuperAdmin() ||
        isRestaurantOwner(resource.data.restaurantId) ||
        (isLivreur() && resource.data.statut in ['Placée', 'En Préparation', 'Prête'])
      );

      // Création : jamais par écriture directe du client. Les Firestore
      // Rules ne peuvent pas sommer un tableau de longueur variable, donc
      // `sousTotal`/`total` ne peuvent pas être vérifiés ici contre le vrai
      // contenu de `plats` — createOrderAction (Admin SDK, qui contourne
      // ces rules) relit les vrais prix/`plats/{id}`/frais de livraison
      // avant d'écrire quoi que ce soit et est désormais l'unique voie de
      // création d'une commande.
      allow create: if false;

      allow update: if isAuth() && (
          isSuperAdmin() ||

          // Le restaurateur accepte (Placée -> En Préparation)
          ((resource.data.restaurateurId == request.auth.uid || isRestaurantOwner(resource.data.restaurantId)) &&
           resource.data.statut == 'Placée' && request.resource.data.statut == 'En Préparation' &&
           orderCoreUnchanged()) ||

          // Le restaurateur marque prête (En Préparation -> Prête)
          ((resource.data.restaurateurId == request.auth.uid || isRestaurantOwner(resource.data.restaurantId)) &&
           resource.data.statut == 'En Préparation' && request.resource.data.statut == 'Prête' &&
           orderCoreUnchanged()) ||

          // Le livreur prend en charge (Placée/En Préparation/Prête -> En Route)
          (isLivreur() &&
           resource.data.statut in ['Placée', 'En Préparation', 'Prête'] &&
           request.resource.data.statut == 'En Route' && request.resource.data.livreurId == request.auth.uid &&
           orderCoreUnchanged()) ||

          // Le livreur termine (En Route -> Livrée)
          (resource.data.livreurId == request.auth.uid && resource.data.statut == 'En Route' &&
           request.resource.data.statut == 'Livrée' &&
           orderCoreUnchanged()) ||

          // Le client annule sa propre commande tant qu'elle n'est pas
          // prise en charge par le restaurateur (statut encore 'Placée'),
          // sans pouvoir modifier son contenu ni ses montants.
          (resource.data.userId == request.auth.uid &&
           resource.data.statut == 'Placée' && request.resource.data.statut == 'Annulée' &&
           orderCoreUnchanged())
      );

      allow delete: if isSuperAdmin();
    }

    // Avis vérifiés : un avis n'existe que pour une commande LIVRÉE,
    // appartenant à son auteur, sur le même restaurant. L'id du document
    // DOIT être l'orderId : cela garantit mécaniquement un avis unique par
    // commande (une seconde tentative sur le même orderId devient une
    // "update", refusée ci-dessous) sans avoir besoin d'une requête de
    // vérification d'unicité.
    function orderAllowsReview(orderId, restaurantId) {
      let order = get(/databases/$(database)/documents/commandes/$(orderId)).data;
      return order.userId == request.auth.uid
        && order.restaurantId == restaurantId
        && order.statut == 'Livrée';
    }

    match /avis/{avisId} {
      allow read, list: if true;

      allow create: if isAuth()
        && isUser(request.resource.data.userId)
        && avisId == request.resource.data.orderId
        && request.resource.data.note >= 1
        && request.resource.data.note <= 5
        && orderAllowsReview(request.resource.data.orderId, request.resource.data.restaurantId);

      // Immuable une fois posté : un avis "vérifié" ne peut pas être
      // retouché après coup, y compris par un SuperAdmin.
      allow update, delete: if false;
    }

    // Promotions ciblées : coupons de réduction créés par un restaurateur
    // pour son propre restaurant. L'id du document = le code lui-même
    // (majuscules) — la lecture par code exact (`get`) est ouverte à tout
    // utilisateur authentifié pour permettre la saisie du code au moment du
    // paiement. `list` est en revanche restreint au propriétaire : sans ça,
    // n'importe quel restaurateur pourrait lister les codes de ses
    // concurrents.
    match /coupons/{couponId} {
      allow get: if isAuth();
      allow list: if isAuth()
        && (resource.data.restaurateurId == request.auth.uid || isSuperAdmin());

      allow create: if isAuth()
        && isRestaurantOwner(request.resource.data.restaurantId)
        && isUser(request.resource.data.restaurateurId)
        && couponId == request.resource.data.code
        && request.resource.data.code.matches('^[A-Z0-9]{4,12}$')
        && request.resource.data.type in ['pourcentage', 'montant_fixe']
        && request.resource.data.valeur > 0
        && (request.resource.data.type != 'pourcentage' || request.resource.data.valeur <= 100);

      // Seul l'interrupteur actif/inactif peut être modifié après coup —
      // pas de compteur d'utilisations à faire avancer ni de valeur à
      // retoucher discrètement une fois le code diffusé.
      allow update: if isAuth()
        && (resource.data.restaurateurId == request.auth.uid || isRestaurantOwner(resource.data.restaurantId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actif']);

      allow delete: if isAuth()
        && (resource.data.restaurateurId == request.auth.uid || isRestaurantOwner(resource.data.restaurantId) || isSuperAdmin());
    }

    // Table de correspondance transactionId -> (collection, docId), écrite
    // uniquement par payment-actions.ts/premium-actions.ts et lue
    // uniquement par les webhooks CinetPay, tous deux via l'Admin SDK (qui
    // contourne ces rules). Aucun accès client, jamais — explicite plutôt
    // que de compter sur le refus par défaut de Firestore.
    match /payment_transactions/{transactionId} {
      allow read, write: if false;
    }

    // Abonnement Premium : achat ponctuel (pas de vrai prélèvement
    // récurrent en Mobile Money) qui prolonge `premiumJusquau` sur le
    // profil. Espèces exclues — aucun livreur n'intervient pour un
    // abonnement, donc pas de collecte physique possible. Seul le webhook
    // CinetPay (Admin SDK) peut faire avancer `paiement` après création.
    // `montant`/`dureeJours` sont verrouillés aux constantes de l'app
    // (PREMIUM_PRICE_FCFA/PREMIUM_DURATION_DAYS, src/lib/premium.ts) —
    // sans ça un client pourrait créer un abonnement à 1 FCFA.
    match /abonnements/{subscriptionId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isSuperAdmin());

      allow create: if isAuth()
        && isUser(request.resource.data.userId)
        && request.resource.data.montant == 2000
        && request.resource.data.dureeJours == 30
        && request.resource.data.paiement.mode in ['orange_money', 'mtn_money', 'moov_money']
        && request.resource.data.paiement.statut == 'en_attente'
        && request.resource.data.paiement.montant == request.resource.data.montant
        && !('transactionId' in request.resource.data.paiement)
        && !('paymentToken' in request.resource.data.paiement)
        && !('dateConfirmation' in request.resource.data.paiement);

      allow update, delete: if false;
    }

    // Profil public d'un livreur (nom + position) consultable par tout
    // utilisateur authentifié pour le suivi de commande. Le livreur est
    // seul autorisé à publier ses propres données.
    match /livreurs_public/{livreurId} {
      allow read: if isAuth();
      allow write: if isUser(livreurId);
    }

    // Journal d'audit des actions administratives. Écriture réservée aux
    // SuperAdmin (avec adminId == auth.uid pour empêcher l'usurpation),
    // lecture réservée aux SuperAdmin, jamais d'update ni de delete —
    // même par un SuperAdmin — pour préserver l'intégrité de la
    // traçabilité (un compte SuperAdmin compromis ne doit pas pouvoir
    // effacer ses propres traces). La purge automatique après 30 jours se
    // fait côté serveur via /api/cron/purge-logs avec l'Admin SDK, qui
    // contourne ces rules.
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.adminId == request.auth.uid;
      allow update, delete: if false;
    }

    // Notifications applicatives (ex: alertes de stock bas, nouvelle
    // commande). Lecture par le destinataire uniquement, qui peut marquer
    // ses notifs comme lues ou les supprimer. La création se fait
    // exclusivement via le SDK Admin côté serveur, donc aucune écriture
    // client n'est autorisée à la création.
    match /notifications/{notifId} {
      allow read: if isUser(resource.data.userId);
      allow update: if isUser(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isUser(resource.data.userId) || isSuperAdmin();
      allow create: if false;
    }

    // ── Stocks ────────────────────────────────────────────────────────────
    match /stocks/{stockId} {
      // Lecture per-doc — `list` est validée à partir de cette même règle,
      // ce qui force les clients à filtrer par `restaurateurId`.
      allow read: if isAuth() && (
        resource.data.restaurateurId == request.auth.uid || isSuperAdmin()
      );

      allow create, update: if isAuth() && (
        request.resource.data.restaurateurId == request.auth.uid || isSuperAdmin()
      );

      allow delete: if isAuth() && (
        resource.data.restaurateurId == request.auth.uid || isSuperAdmin()
      );
    }
  }
}
