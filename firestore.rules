rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isUserAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isUserAuthenticated() && request.auth.uid == uid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data;
    }
    
    function userExists() {
      return exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid));
    }

    function isRestaurantOwner(restaurantId) {
       return isUserAuthenticated() && exists(/databases/$(database)/documents/restaurants/$(restaurantId)) && isUser(get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.proprietaireId);
    }
    
    function isSuperAdmin() {
      return isUserAuthenticated() && 
             userExists() && 
             getUserData().get('roleSysteme', 'User') == 'SuperAdmin';
    }

    match /utilisateurs/{userId} {
      allow read, update: if isUserAuthenticated() && (isUser(userId) || isSuperAdmin());
      allow create: if isUserAuthenticated() && isUser(userId);
    }
    
    match /utilisateurs {
      allow list: if isSuperAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isUserAuthenticated() && isUser(request.resource.data.proprietaireId) && userExists() && getUserData().role == 'restaurateur';
      allow update, delete: if isRestaurantOwner(restaurantId) || isSuperAdmin();
    }
    
    match /restaurants {
      allow list: if true;
    }
    
    match /plats/{platId} {
        allow read: if true;
        allow create: if isUserAuthenticated() && isRestaurantOwner(request.resource.data.restaurantId);
        allow update, delete: if isRestaurantOwner(resource.data.restaurantId) || isSuperAdmin();
    }
    
    match /plats {
      allow list: if true;
    }

    match /commandes/{orderId} {
      allow read: if isUserAuthenticated() && (
        isUser(resource.data.userId) || 
        (resource.data.livreurId != null && isUser(resource.data.livreurId)) || 
        isRestaurantOwner(resource.data.restaurantId) || 
        isSuperAdmin() ||
        (userExists() && (getUserData().role == 'livreur' || getUserData().role == 'restaurateur'))
      );

      allow create: if isUserAuthenticated() && isUser(request.resource.data.userId);

      allow update: if isUserAuthenticated() && (
          // Le restaurateur accepte (Placée -> En Préparation)
          (isRestaurantOwner(resource.data.restaurantId) && resource.data.statut == 'Placée' && request.resource.data.statut == 'En Préparation') ||

          // Le livreur prend en charge (En Préparation -> En Route)
          (userExists() && getUserData().role == 'livreur' && (resource.data.statut == 'En Préparation' || resource.data.statut == 'Placée') && request.resource.data.statut == 'En Route' && request.resource.data.livreurId == request.auth.uid) ||

          // Le livreur termine (En Route -> Livrée)
          (isUser(resource.data.livreurId) && resource.data.statut == 'En Route' && request.resource.data.statut == 'Livrée') ||

          // Le client annule sa commande tant qu'elle n'a pas été acceptée par le restaurateur.
          (isUser(resource.data.userId) && resource.data.statut == 'Placée' && request.resource.data.statut == 'Annulée') ||

          // Le restaurateur peut annuler une commande qui le concerne tant qu'elle n'est pas en route.
          (isRestaurantOwner(resource.data.restaurantId) && (resource.data.statut == 'Placée' || resource.data.statut == 'En Préparation') && request.resource.data.statut == 'Annulée') ||

          // Toute partie prenante peut ajouter un incident sans changer le statut.
          (
            (isUser(resource.data.userId) || isUser(resource.data.livreurId) || isRestaurantOwner(resource.data.restaurantId))
            && request.resource.data.statut == resource.data.statut
          ) ||

          // Mise à jour de la position du livreur ou du paiement (statut inchangé).
          (
            isUser(resource.data.userId)
            && request.resource.data.statut == resource.data.statut
          ) ||

          isSuperAdmin()
      );
      
      allow list: if isUserAuthenticated() && (
        userExists() && (getUserData().role == 'livreur' || getUserData().role == 'restaurateur' || getUserData().get('roleSysteme', 'User') == 'SuperAdmin')
      );
    }

    // Chat intra-commande : seuls le client et le livreur de la commande
    // peuvent lire et écrire les messages.
    match /commandes/{orderId}/messages/{messageId} {
      function isOrderClient() {
        return isUserAuthenticated()
          && isUser(get(/databases/$(database)/documents/commandes/$(orderId)).data.userId);
      }
      function isOrderLivreur() {
        return isUserAuthenticated()
          && isUser(get(/databases/$(database)/documents/commandes/$(orderId)).data.livreurId);
      }
      allow read, list: if isOrderClient() || isOrderLivreur() || isSuperAdmin();
      allow create: if isUserAuthenticated()
        && isUser(request.resource.data.fromUid)
        && (isOrderClient() || isOrderLivreur())
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update, delete: if isSuperAdmin();
    }

    // Avis clients persistés. Lecture publique (pour afficher sur les
    // pages restaurant), écriture authentifiée par l'auteur lui-même.
    match /avis/{avisId} {
      allow read, list: if true;
      allow create: if isUserAuthenticated()
        && isUser(request.resource.data.userId)
        && request.resource.data.note is number
        && request.resource.data.note >= 1
        && request.resource.data.note <= 5
        && request.resource.data.commentaire is string
        && request.resource.data.commentaire.size() >= 5
        && request.resource.data.commentaire.size() <= 1000
        && request.resource.data.restaurantId is string;
      allow update, delete: if isUserAuthenticated()
        && (isUser(resource.data.userId) || isSuperAdmin());
    }

    // Parrainages : ledger de bonus crédités au parrain par les filleuls.
    // Chaque doc est créé par le filleul à sa première commande utilisant un code.
    // Le parrain interroge ensuite ce ledger en filtrant sur son propre code
    // (donné en clair sur son profil) pour additionner ses points bonus.
    match /parrainages/{parrainageId} {
      allow create: if isUserAuthenticated()
        && isUser(request.resource.data.filleulUid)
        && request.resource.data.parrainCode is string
        && request.resource.data.parrainCode.size() > 0
        && request.resource.data.pointsBonus is number
        && request.resource.data.pointsBonus > 0
        && request.resource.data.pointsBonus <= 1000;

      // Lecture publique authentifiée : la donnée n'est pas sensible
      // (code + uid filleul + points), et le parrain doit pouvoir requêter.
      allow read: if isUserAuthenticated();

      allow update, delete: if isSuperAdmin();
    }

    match /parrainages {
      allow list: if isUserAuthenticated();
    }
  }
}
