rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid));
    }

    function getRole() {
      return isAuth() ? getUserData().get('role', 'client') : 'client';
    }

    function getSystemRole() {
      return isAuth() && userExists() ? getUserData().get('roleSysteme', 'User') : 'User';
    }

    function isSuperAdmin() {
      return isAuth() && getSystemRole() == 'SuperAdmin';
    }

    function isRestaurateur() {
      return isAuth() && getRole() == 'restaurateur';
    }

    function isLivreur() {
      return isAuth() && getRole() == 'livreur';
    }

    function isRestaurantOwner(restaurantId) {
      return isAuth()
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId))
        && isUser(get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.proprietaireId);
    }

    // Empêche un utilisateur d'auto-promouvoir son rôle ou son niveau
    // système en se mettant à jour lui-même.
    function userPrivilegesUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.get('roleSysteme', 'User')
             == resource.data.get('roleSysteme', 'User');
    }

    // Empêche la mutation des champs sensibles d'une commande lors d'une
    // transition d'état (le statut et livreurId sont gérés à part).
    function orderCoreUnchanged() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.restaurateurId == resource.data.restaurateurId
        && request.resource.data.total == resource.data.total
        && request.resource.data.sousTotal == resource.data.sousTotal
        && request.resource.data.fraisDeLivraison == resource.data.fraisDeLivraison
        && request.resource.data.tauxCommission == resource.data.tauxCommission
        && request.resource.data.montantCommission == resource.data.montantCommission
        && request.resource.data.revenuNet == resource.data.revenuNet
        && request.resource.data.plats == resource.data.plats
        && request.resource.data.date == resource.data.date;
    }

    // ── Utilisateurs ─────────────────────────────────────────────────────
    match /utilisateurs/{userId} {
      allow get:    if isAuth() && (isUser(userId) || isSuperAdmin());
      allow list:   if isSuperAdmin();
      allow create: if isAuth()
        && isUser(userId)
        && request.resource.data.role in ['client', 'restaurateur', 'livreur']
        && request.resource.data.get('roleSysteme', 'User') == 'User';
      // Self-update OK mais role / roleSysteme verrouillés.
      // SuperAdmin peut tout modifier.
      allow update: if isAuth() && (
        (isUser(userId) && userPrivilegesUnchanged()) ||
        isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // ── Restaurants ───────────────────────────────────────────────────────
    match /restaurants/{restaurantId} {
      allow read, list: if true;
      allow create: if isAuth()
        && isUser(request.resource.data.proprietaireId)
        && userExists()
        && (getUserData().role == 'restaurateur' || isSuperAdmin());
      allow update: if isRestaurantOwner(restaurantId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Plats ─────────────────────────────────────────────────────────────
    match /plats/{platId} {
      allow read, list: if true;
      allow create: if isAuth() && isRestaurantOwner(request.resource.data.restaurantId);
      allow update, delete: if isRestaurantOwner(resource.data.restaurantId) || isSuperAdmin();
    }

    // ── Commandes ─────────────────────────────────────────────────────────
    // `allow read` couvre `get` ET `list`. Le moteur valide qu'une query
    // sur /commandes a des `where()` qui correspondent aux identités
    // autorisées (userId, restaurateurId, livreurId), sinon elle échoue.
    match /commandes/{orderId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.restaurateurId == request.auth.uid ||
        resource.data.livreurId == request.auth.uid ||
        (isLivreur() && resource.data.statut in ['En Préparation', 'Placée', 'Prête'])
      );

      // Création : champs serveur verrouillés.
      allow create: if isAuth()
        && isUser(request.resource.data.userId)
        && request.resource.data.statut == 'Placée'
        && !('livreurId' in request.resource.data)
        && exists(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId))
        && request.resource.data.restaurateurId ==
             get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data.proprietaireId;

      allow update: if isAuth() && (
        isSuperAdmin() ||

        // Restaurateur : accepte (Placée → En Préparation)
        ((resource.data.restaurateurId == request.auth.uid || isRestaurantOwner(resource.data.restaurantId))
          && resource.data.statut == 'Placée'
          && request.resource.data.statut == 'En Préparation'
          && orderCoreUnchanged()) ||

        // Restaurateur : marque prête (En Préparation → Prête)
        ((resource.data.restaurateurId == request.auth.uid || isRestaurantOwner(resource.data.restaurantId))
          && resource.data.statut == 'En Préparation'
          && request.resource.data.statut == 'Prête'
          && orderCoreUnchanged()) ||

        // Livreur : prend en charge (Placée/En Préparation/Prête → En Route)
        (isLivreur()
          && resource.data.statut in ['Placée', 'En Préparation', 'Prête']
          && request.resource.data.statut == 'En Route'
          && request.resource.data.livreurId == request.auth.uid
          && orderCoreUnchanged()) ||

        // Livreur : livre (En Route → Livrée)
        (resource.data.livreurId == request.auth.uid
          && resource.data.statut == 'En Route'
          && request.resource.data.statut == 'Livrée'
          && orderCoreUnchanged()) ||

        // Client : annule sa propre commande tant qu'elle n'est pas prise
        // en charge (et sans pouvoir modifier le contenu / les montants).
        (resource.data.userId == request.auth.uid
          && resource.data.statut == 'Placée'
          && request.resource.data.statut == 'Annulée'
          && orderCoreUnchanged())
      );

      allow delete: if isSuperAdmin();
    }

    // ── Stocks ────────────────────────────────────────────────────────────
    match /stocks/{stockId} {
      allow list: if isAuth() && (isSuperAdmin() || isRestaurateur());
      allow get:  if isAuth() && (
        isSuperAdmin() ||
        resource.data.restaurateurId == request.auth.uid
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        (isRestaurateur() && request.resource.data.restaurateurId == request.auth.uid)
      );
      allow update, delete: if isAuth() && (
        isSuperAdmin() ||
        resource.data.restaurateurId == request.auth.uid
      );
    }

    // ── Avis / Reviews ────────────────────────────────────────────────────
    match /avis/{avisId} {
      allow read, list: if true;
      allow create: if isAuth() && isUser(request.resource.data.userId);
      allow update, delete: if isAuth() && (isUser(resource.data.userId) || isSuperAdmin());
    }

    // ── Notifications ─────────────────────────────────────────────────────
    // Création réservée à l'Admin SDK côté serveur (server actions). Les
    // clients ne peuvent que lire / mettre à jour (ex: marquer lu) /
    // supprimer leurs propres notifications.
    match /notifications/{notifId} {
      allow list: if isAuth() && resource.data.destinataireId == request.auth.uid;
      allow get:  if isAuth() && resource.data.destinataireId == request.auth.uid;
      allow create: if false;
      allow update: if isAuth()
        && resource.data.destinataireId == request.auth.uid
        && request.resource.data.destinataireId == resource.data.destinataireId;
      allow delete: if isAuth() && (
        resource.data.destinataireId == request.auth.uid || isSuperAdmin()
      );
    }

    // ── Boost / Promotions ────────────────────────────────────────────────
    match /boosts/{boostId} {
      allow read, list: if true;
      allow create: if isAuth() && isRestaurateur();
      allow update, delete: if isAuth() && (
        resource.data.restaurateurId == request.auth.uid || isSuperAdmin()
      );
    }

    // ── Audit Logs ────────────────────────────────────────────────────────
    // Lecture/suppression: SuperAdmin uniquement (la purge automatique 30j
    // se fait côté serveur via /api/cron/purge-logs avec l'Admin SDK).
    // Création: SuperAdmin avec adminId == auth.uid pour empêcher les
    // logs forgés sous l'identité d'un autre admin.
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin()
        && request.resource.data.adminId == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ── Profil public livreur (suivi de commande) ─────────────────────────
    // Projection minimale (nom + position) lue par tout utilisateur
    // authentifié pour permettre le tracking client. Le livreur publie
    // ses propres données via les hooks de service.
    match /livreurs_public/{livreurId} {
      allow read: if isAuth();
      allow write: if isUser(livreurId);
    }
  }
}
