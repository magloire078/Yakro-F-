rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isUserAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isUserAuthenticated() && request.auth.uid == uid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data;
    }

    function isRestaurantOwner(restaurantId) {
       // On vérifie si l'utilisateur authentifié est le propriétaire du restaurant référencé
       return isUser(get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.proprietaireId);
    }
    
    function isSuperAdmin() {
      // Vérification sécurisée du rôle système SuperAdmin
      return isUserAuthenticated() && 
             exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)) && 
             getUserData().roleSysteme == 'SuperAdmin';
    }

    match /restaurants {
      // Tout le monde peut voir la liste des restaurants
      allow list: if true;
    }

    match /restaurants/{restaurantId} {
      // Tout le monde peut lire les détails d'un restaurant
      allow read: if true;
      // Création réservée aux restaurateurs authentifiés
      allow create: if isUser(request.resource.data.proprietaireId) && getUserData().role == 'restaurateur';
      // Modification/Suppression réservée au propriétaire ou admin
      allow update, delete: if isRestaurantOwner(restaurantId) || isSuperAdmin();
    }
    
    match /plats {
       // Tout le monde peut voir la liste des plats (recherche)
      allow list: if true;
    }

    match /plats/{platId} {
        allow read: if true;
        allow create: if isRestaurantOwner(request.resource.data.restaurantId);
        allow update, delete: if isRestaurantOwner(resource.data.restaurantId) || isSuperAdmin();
    }

    match /commandes/{orderId} {
      // Un utilisateur peut lire une commande si :
      // 1. Il est le client, le livreur assigné ou le propriétaire du restaurant
      // 2. Il est un livreur et la commande est "En Préparation" (pour la liste des courses dispos)
      // 3. Il est SuperAdmin
      allow read: if isUser(resource.data.userId) || 
                     (resource.data.livreurId != null && isUser(resource.data.livreurId)) || 
                     isRestaurantOwner(resource.data.restaurantId) || 
                     isSuperAdmin() ||
                     (resource.data.statut == 'En Préparation' && getUserData().role == 'livreur');

      // Un utilisateur ne peut créer une commande que pour lui-même
      allow create: if isUser(request.resource.data.userId);

      allow update: if 
          // Le restaurateur accepte la commande
          (isRestaurantOwner(resource.data.restaurantId) && resource.data.statut == 'Placée' && request.resource.data.statut == 'En Préparation') ||
          
          // Un livreur prend la commande
          (isUserAuthenticated() && getUserData().role == 'livreur' && resource.data.statut == 'En Préparation' && request.resource.data.statut == 'En Route' && request.resource.data.livreurId == request.auth.uid) ||
          
          // Le livreur valide la livraison
          (isUser(resource.data.livreurId) && resource.data.statut == 'En Route' && request.resource.data.statut == 'Livrée') ||
          
          isSuperAdmin();
    }

    match /utilisateurs/{userId} {
      allow read: if isUser(userId) || isSuperAdmin();
      allow update: if isUser(userId) || isSuperAdmin();
      allow create: if isUser(userId);
    }
    
     match /utilisateurs {
        allow list: if isSuperAdmin();
    }
  }
}
